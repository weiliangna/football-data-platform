[Unit]
Description=Hongrui Football Results Sync
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=admin
WorkingDirectory=/www/wwwroot/football_system
EnvironmentFile=/www/wwwroot/football_system/config/database.env
EnvironmentFile=/www/wwwroot/football_system/config/hongrui.env
ExecStart=/www/wwwroot/football_system/venv/bin/python -m spider.run_job --name hongrui-results --platform-id 3 --module spider.hongrui_results
