[Unit]
Description=Football Automatic Settlement
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=admin
WorkingDirectory=/www/wwwroot/football_system
EnvironmentFile=/www/wwwroot/football_system/config/database.env
ExecStart=/www/wwwroot/football_system/venv/bin/python -m spider.run_job --name football-settlement --module spider.auto_settlement
