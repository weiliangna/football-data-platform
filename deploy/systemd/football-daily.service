[Unit]
Description=Football Daily Result and Ranking Tasks
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=admin
WorkingDirectory=/www/wwwroot/football_system
EnvironmentFile=/www/wwwroot/football_system/config/database.env
ExecStart=/www/wwwroot/football_system/venv/bin/python /www/wwwroot/football_system/scheduler/daily_task.py
