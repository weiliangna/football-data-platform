[Unit]
Description=Football Database Backup
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=admin
WorkingDirectory=/www/wwwroot/football_system
EnvironmentFile=/www/wwwroot/football_system/config/database.env
ExecStart=/www/wwwroot/football_system/venv/bin/python -m scripts.backup_db
