<template>

<div class="page">


<h1>
用户管理
</h1>


<div class="toolbar">


<select v-model="platform">

<option value="1">
彩站云
</option>


<option value="2">
州运宝
</option>


<option value="3">
鸿瑞
</option>


<option value="4">
云彩
</option>


</select>


<button @click="loadUsers">
刷新
</button>


</div>



<div class="list">


<div

class="user-card"

v-for="item in users"

:key="item.user_id"

>


<div class="top">


<h2>
{{item.nickname}}
</h2>


<span class="level">
{{item.level}}
</span>


</div>



<div class="info">


<div>

总发单

<strong>
{{item.order_count}}
</strong>

</div>



<div>

胜率

<strong>
{{item.avg_hit_rate*100}}%

</strong>


</div>




<div>

盈利能力

<strong>
{{item.avg_profitability}}

</strong>


</div>



<div>

跟单人数

<strong>
{{item.avg_follow}}

</strong>


</div>



</div>



<button

@click="detail(item.user_id)"

>

查看详情

</button>



</div>



</div>



</div>


</template>




<script setup>

import {
ref,
onMounted
}
from "vue"


import axios from "axios"


import {
useRouter
}
from "vue-router"



const router=useRouter()


const users=ref([])


const platform=ref(1)



async function loadUsers(){


let res=await axios.get(
"/api/user/list"
)


users.value=res.data.data


}




function detail(id){


router.push(

"/expert/detail/"+platform.value+"/"+id

)


}



onMounted(()=>{


loadUsers()


})


</script>




